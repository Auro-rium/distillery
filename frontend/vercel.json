{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/static-api/health"
    },
    {
      "source": "/api/config",
      "destination": "/static-api/config"
    },
    {
      "source": "/api/replay",
      "destination": "/static-api/replay"
    },
    {
      "source": "/api/runs/sql-tiny-live1",
      "destination": "/static-api/by-run/sql-tiny-live1/detail"
    },
    {
      "source": "/api/runs/sql-tiny-live1/report",
      "destination": "/static-api/by-run/sql-tiny-live1/report"
    },
    {
      "source": "/api/runs/sql-tiny-live1/tree",
      "destination": "/static-api/by-run/sql-tiny-live1/tree"
    },
    {
      "source": "/api/runs/sql-tiny-live1/events",
      "destination": "/static-api/by-run/sql-tiny-live1/events"
    },
    {
      "source": "/api/runs/sql-tiny-live1/examples",
      "has": [
        {
          "type": "query",
          "key": "kind",
          "value": "all"
        }
      ],
      "destination": "/static-api/by-run/sql-tiny-live1/examples-all"
    },
    {
      "source": "/api/runs/sql-tiny-live1/examples",
      "has": [
        {
          "type": "query",
          "key": "kind",
          "value": "fixed"
        }
      ],
      "destination": "/static-api/by-run/sql-tiny-live1/examples-fixed"
    },
    {
      "source": "/api/runs/sql-tiny-live1/examples",
      "has": [
        {
          "type": "query",
          "key": "kind",
          "value": "still_wrong"
        }
      ],
      "destination": "/static-api/by-run/sql-tiny-live1/examples-still_wrong"
    },
    {
      "source": "/api/runs/sql-tiny-live1/examples",
      "has": [
        {
          "type": "query",
          "key": "kind",
          "value": "regressed"
        }
      ],
      "destination": "/static-api/by-run/sql-tiny-live1/examples-regressed"
    },
    {
      "source": "/api/runs",
      "destination": "/static-api/runs-index"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-4EDjg6SqtC+vvrW1RBVkSwHxntCpS8JHIMD5RFAjbh4='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://REPLACE-WITH-API-ORIGIN.example; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/static-api/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/static-api/by-run/sql-tiny-live1/events",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/event-stream; charset=utf-8"
        }
      ]
    },
    {
      "source": "/static-api/by-run/sql-tiny-live1/examples-all",
      "headers": [
        {
          "key": "x-examples-available",
          "value": "true"
        },
        {
          "key": "x-examples-cap-per-kind",
          "value": "20"
        },
        {
          "key": "x-examples-totals",
          "value": "{\"fixed\":0,\"still_wrong\":17,\"regressed\":0}"
        }
      ]
    },
    {
      "source": "/static-api/by-run/sql-tiny-live1/examples-fixed",
      "headers": [
        {
          "key": "x-examples-available",
          "value": "true"
        },
        {
          "key": "x-examples-cap-per-kind",
          "value": "20"
        },
        {
          "key": "x-examples-totals",
          "value": "{\"fixed\":0,\"still_wrong\":17,\"regressed\":0}"
        }
      ]
    },
    {
      "source": "/static-api/by-run/sql-tiny-live1/examples-still_wrong",
      "headers": [
        {
          "key": "x-examples-available",
          "value": "true"
        },
        {
          "key": "x-examples-cap-per-kind",
          "value": "20"
        },
        {
          "key": "x-examples-totals",
          "value": "{\"fixed\":0,\"still_wrong\":17,\"regressed\":0}"
        }
      ]
    },
    {
      "source": "/static-api/by-run/sql-tiny-live1/examples-regressed",
      "headers": [
        {
          "key": "x-examples-available",
          "value": "true"
        },
        {
          "key": "x-examples-cap-per-kind",
          "value": "20"
        },
        {
          "key": "x-examples-totals",
          "value": "{\"fixed\":0,\"still_wrong\":17,\"regressed\":0}"
        }
      ]
    }
  ]
}
