ROM accounts WHERE status = 'deleted' OR status = 'trial') AND user_id NOT IN (SELECT user_id FROM support_tickets WHERE user_id IS NOT NULL) AND status = 'viewer'","family":"anti_join","gold_sql":"SELECT u.user_id FROM users u JOIN accounts a ON a.account_id = u.account_id WHERE u.role = 'viewer' AND a.country = 'DE' AND u.deleted_at IS NULL AND NOT EXISTS (SELECT 1 FROM support_tickets t WHERE t.user_id = u.user_id)","heldout_class":"unseen_table_combo","kind":"still_wrong","question":"List user_ids of viewer users who are not deleted from DE accounts that do not appear as the submitter of any ticket.","student_ok":false,"student_sql":"SELECT u.user_id\nFROM users u\nWHERE u.status = 'viewer'\n  AND u.deleted_at IS NULL\n  AND u.account_id NOT IN (\n    SELECT account_id\n    FROM accounts\n    WHERE status = 'deleted'\n  )","task_id":"sql-9e9e2673337e","teacher_ok":true,"teacher_sql":"SELECT u.user_id\nFROM users u\nJOIN accounts a ON u.account_id = a.account_id\nWHERE u.role = 'viewer'\n  AND u.deleted_at IS NULL\n  AND a.country = 'DE'\n  AND NOT EXISTS (\n    SELECT 1 FROM support_tickets t WHERE t.user_id = u.user_id\n  )"}]