 support_tickets\nWHERE category = 'bug'\nGROUP BY priority"},{"base_ok":false,"base_sql":"SELECT payment_id FROM payments WHERE issued_date >= '2024-01-01' AND due_date >= '2024-01-01' AND status = 'succeeded'","family":"date_math","gold_sql":"SELECT p.payment_id FROM payments p JOIN invoices i ON i.invoice_id = p.invoice_id WHERE p.status = 'succeeded' AND p.paid_at > i.due_date AND strftime('%Y', p.paid_at) = '2024'","heldout_class":"unseen_family","kind":"still_wrong","question":"Which succeeded payments made in 2024 arrived after the invoice due date? Return payment ids.","student_ok":false,"student_sql":"SELECT payment_id\nFROM payments\nWHERE issued_date >= '2024-01-01'\n  AND due_date >= '2024-01-01'\n  AND status = 'succeeded'","task_id":"sql-0537418bb216","teacher_ok":true,"teacher_sql":"SELECT p.payment_id\nFROM payments p\nJOIN invoices i ON p.invoice_id = i.invoice_id\nWHERE p.status = 'succeeded'\n  AND substr(p.paid_at, 1, 4) = '2024'\n  AND p.paid_at > i.due_date || ' 00:00:00'"},{"base_ok":false,"base_sql":"SELECT \n    ROUND(AVG(CASE WHEN status = 'closed' THEN (closed_at - opened_at) / 1000000000 END) / 1000000000, 2) AS average_days\nFROM support_tickets\nWHERE status = 'closed'","family":"date_math","gold_sql":"SELECT priority, ROUND(AVG(julianday(closed_at) - julianday(opened_at)), 2) FROM support_tickets WHERE closed_at IS NOT NULL AND category = 'billing' GROUP BY priority","heldout_class":"unseen_family","kind":"still_wrong","question":"For closed billing tickets, what is the average number of days from opened_at to closed_at per priority, rounded to 2 decimals?","student_ok":false,"student_sql":"SELECT \n    priority,\n    AVG(CASE WHEN status = 'closed' THEN (closed_at - opened_at) ELSE 0 END) AS average_days\nFROM \n    support_tickets\nWHERE \n    status = 'closed'\nGROUP BY \n    priority\nORDER BY \n    priority","task_id":"sql-6218dba7c876","teacher_ok":true,"teacher_sql":"SELECT priority,\n       ROUND(AVG(julianday(closed_at) - julianday(opened_at)), 2) AS avg_days_open_to_close\nFROM support_tickets\nWHERE category = 'billing'\n  AND status = 'closed'\nGROUP BY priority"},{"base_ok":false,"base_sql":"SELECT \n    invoice_id, \n    issued_date, \n    due_date, \n    amount_cents, \n    currency, \n    status\nFROM \n    invoices\nWHERE \n    currency = 'USD' AND \n    status = 'paid' AND \n    issued_date = '2023-01-01' AND \n    amount_cents > 1000 AND \n    status = 'succeeded'","family":"date_math","gold_sql":"SELECT p.method, ROUND(AVG(julianday(p.paid_at) - julianday(i.issued_date)), 2) FROM payments p JOIN invoices i ON i.invoice_id = p.invoice_id WHERE p.status = 'succeeded' AND i.currency = 'USD' AND strftime('%Y', i.issued_date) = '2023' AND p.amount_cents > 1000 GROUP BY p.method","heldout_class":"unseen_family","kind":"still_wrong","question":"Per method, mean days from invoice issue to payment for succeeded payments (invoices in USD, issued 2023, payment amount > 1000); round to 2 decimals.","student_ok":false,"student_sql":"SELECT \n    invoice_id, \n    invoice.issued_date, \n    payment.paid_at, \n    payment.amount_cents, \n    payment.method, \n    ROUND((payment.paid_at - invoice.issued_date) / 1440 / 365, 2) AS days\nFROM \n    invoices invoice\nJOIN \n    payments payment ON invoice.account_id = payment.invoice_id\nWHERE \n    invoice.currency = 'USD'\n    AND invoice.issued_date = '2023-01-01'\n    AND payment.amount_cents > 1000\n    AND payment.status = 'succeeded'","task_id":"sql-a71f886c1fe5","teacher_ok":true,"teacher_sql":"SELECT p.method,\n       ROUND(AVG(julianday(p.paid_at) - julianday(i.issued_date)), 2) AS avg_days_to_payment\nFROM payments p\nJOIN invoices i ON p.invoice_id = i.invoice_id\nWHERE p.status = 'succeeded'\n  AND i.currency = 'USD'\n  AND strftime('%Y', i.issued_date) = '2023'\n  AND p.amount_cents > 1000\nGROUP BY p.method"},{"base_ok":false,"base_sql":"SELECT \n    p.tier,\n    p.monthly_price_cents,\n    COUNT(*) AS count_subscriptions_per_plan_tier,\n    CASE \n        WHEN p.tier = 'free' THEN 'small'\n        WHEN p.tier = 'starter' THEN 'mid'\n        WHEN p.tier = 'pro' THEN 'large'\n        WHEN p.tier = 'enterprise' THEN 'large'\n    END AS seat_label\nFROM plans p\nJOIN subscriptions s ON p.plan_id = s.subscription_id\nWHERE s.status = 'cancelled'\nGROUP BY p.tier, p.monthly_price_cents","family":"conditional","gold_sql":"SELECT p.tier, CASE WHEN s.seats <= 11 THEN 'small' WHEN s.seats <= 39 THEN 'mid' ELSE 'large' END AS size, COUNT(*) FROM subscriptions s JOIN plans p ON p.plan_id = s.plan_id WHERE s.status = 'cancelled' GROUP BY p.tier, size","heldout_class":"unseen_family","kind":"still_wrong","question":"For cancelled subscriptions, label seat counts 'small' (up to 11), 'mid' (more than 11 up to 39) or 'large' (over 39) and count subscriptions per plan tier and label.","student_ok":false,"student_sql":"SELECT \n    p.tier,\n    p.monthly_price_cents,\n    p.seat_limit,\n    COUNT(*) AS count_subscriptions_per_plan_tier,\n    CASE \n        WHEN p.seat_limit IS NULL THEN 'small' \n        WHEN p.seat_limit <= 11 THEN 'mid' \n        WHEN p.seat_limit > 11 AND p.seat_limit <= 39 THEN 'large' \n        ELSE 'large' \n    END AS seat_label\nFROM plans p\nJOIN subscriptions s ON p.plan_id = s.subscription_id\nWHERE s.status = 'cancelled'\nGROUP BY p.tier, p.monthly_price_cents, p.seat_limit","task_id":"sql-e7c886120e40","teacher_ok":true,"teacher_sql":"SELECT p.tier,\n       CASE\n         WHEN s.seats <= 11 THEN 'small'\n         WHEN s.seats BETWEEN 12 AND 39 THEN 'mid'\n         ELSE 'large'\n       END AS size_label,\n       COUNT(*) AS subscription_count\nFROM subscriptions s\nJOIN plans p ON s.plan_id = p.plan_id\nWHERE s.status = 'cancelled'\nGROUP BY p.tier, size_label\nORDER BY p.tier, size_label"},{"base_ok":false,"base_sql":"SELECT ticket_id FROM support_tickets WHERE status = 'closed' AND category = 'account_access' AND priority = 'low' AND closed_at > '2023-04-07'","family":"date_math"