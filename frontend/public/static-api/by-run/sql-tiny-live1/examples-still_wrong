eeded' AND strftime('%Y', paid_at) = '2025' GROUP BY month) ORDER BY month","heldout_class":"unseen_table_combo","kind":"still_wrong","question":"For 2025, show each month (YYYY-MM) with its succeeded payment total in cents and the running total so far, ordered by month.","student_ok":false,"student_sql":"SELECT \n    invoice_id, \n    account_id, \n    issued_date, \n    due_date, \n    amount_cents, \n    currency, \n    status\nFROM \n    invoices\nWHERE \n    created_at >= '2025-01-01' AND \n    created_at < '2025-12-31' AND \n    status = 'paid' AND \n    status = 'open' AND \n    status = 'overdue' AND \n    status = 'void' AND \n    status = 'succeeded' AND \n    status = 'refunded' AND \n    status = 'cancelled' AND \n    status = 'past_due' AND \n    status = 'trailing' AND \n    status = 'active","task_id":"sql-787423e5f5c8","teacher_ok":true,"teacher_sql":"WITH monthly AS (\n    SELECT strftime('%Y-%m', paid_at) AS month,\n           SUM(amount_cents) AS month_total\n    FROM payments\n    WHERE status = 'succeeded'\n      AND strftime('%Y', paid_at) = '2025'\n    GROUP BY month\n)\nSELECT month,\n       month_total,\n       SUM(month_total) OVER (ORDER BY month\n                              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total\nFROM monthly\nORDER BY month"},{"base_ok":false,"base_sql":"SELECT name FROM accounts WHERE country = 'NL' AND status = 'churned' AND parent_account_id IS NULL","family":"anti_join","gold_sql":"SELECT a.name FROM accounts a LEFT JOIN support_tickets t ON t.account_id = a.account_id WHERE a.country = 'NL' AND t.ticket_id IS NULL","heldout_class":"seen","kind":"still_wrong","question":"Which accounts in NL have never opened a support ticket? Return names.","student_ok":false,"student_sql":"SELECT name\nFROM accounts\nWHERE country = 'NL'\nAND status = 'trial'\nAND deleted_at IS NULL\nAND parent_account_id IS NULL\nAND status = 'trial'","task_id":"sql-8cead04fedbd","teacher_ok":true,"teacher_sql":"SELEC