# Copy to .env and fill in. Never commit .env. Never print or log these values.

# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Sandboxes (Contree SDK). Exact variable names are recorded in
# docs/NEBIUS_NOTES.md after spike S2; do not guess them here.

# Admin token: required for anything that spends money (compared with hmac.compare_digest)
DISTILLERY_ADMIN_TOKEN=

# Budget caps in USD (Section 7 of the build spec)
DISTILLERY_RUN_CAP_USD=10
DISTILLERY_PROJECT_CAP_USD=40
DISTILLERY_PLAYGROUND_DAILY_CAP_USD=1
