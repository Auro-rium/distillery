# Copy to .env and fill in. Never commit .env. Never print or log these values.
# Secrets below are intentionally empty.

# --- Nebius Token Factory (OpenAI-compatible) -------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Sandboxes (Contree SDK) -------------------------------------------------
# Sandboxes need a project id: without it the API answers 400 `Missing "Project" header`
# (see FEEDBACK.md). Fill in from the Nebius console.
NEBIUS_AI_PROJECT=
# Optional overrides read by the CLI. Leave empty to use the SDK default
# (https://api.tokenfactory.nebius.com/sandboxes). The image needs python + sqlite.
DISTILLERY_SANDBOX_URL=
DISTILLERY_SANDBOX_IMAGE=

# --- Admin token: required for anything that spends money (hmac.compare_digest) ---
DISTILLERY_ADMIN_TOKEN=

# --- Budget caps in USD ------------------------------------------------------
DISTILLERY_RUN_CAP_USD=10
DISTILLERY_PROJECT_CAP_USD=40
DISTILLERY_PLAYGROUND_DAILY_CAP_USD=1

# --- Prices ------------------------------------------------------------------
# Path to a JSON file: {"<model id>": {"input_per_mtok": <usd>, "output_per_mtok": <usd>,
# "source": "<where you read it>", "date": "<YYYY-MM-DD>"}, ...}. The format is defined by
# `Price` in src/distillery/config.py. Token Factory does not expose prices through the API,
# so copy them BY HAND from the Nebius console. Never guess. Without this file live runs
# have no price table.
DISTILLERY_PRICES_FILE=

# --- Model roles (IDs live-verified against GET /v1/models on 2026-09-30) ----
DISTILLERY_MODEL_PLANNER=nvidia/Nemotron-3-Ultra-550b-a55b
DISTILLERY_MODEL_TEACHER=nvidia/nemotron-3-super-120b-a12b
DISTILLERY_MODEL_TRIAGE=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Student: fine-tunable on Token Factory, NOT on the serverless inference list.
DISTILLERY_MODEL_STUDENT=Qwen/Qwen3-0.6B

# --- Server and storage ------------------------------------------------------
# Where runs and the SQLite store live (default: .distillery)
DISTILLERY_HOME=
# Replay bundles directory (default: replay)
DISTILLERY_REPLAY_DIR=
# CORS: comma-separated EXACT origins allowed to call the API from a browser. No wildcards, no
# paths, https required unless localhost. Empty = same origin only (the Docker image serves the
# frontend itself). Only needed for a split deploy. Local Vite dev server:
DISTILLERY_ALLOWED_ORIGINS=http://localhost:5173
# Deprecated alias of DISTILLERY_ALLOWED_ORIGINS, read only when that one is unset.
# DISTILLERY_DEV_ORIGIN=
# Integer seed for the gate's bootstrap (default: 1234)
DISTILLERY_SEED=
